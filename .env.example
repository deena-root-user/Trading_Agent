# ═══════════════════════════════════════════════════════════════════
#  PAXIS TRADING AGENT — ENVIRONMENT CONFIG
#  Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════

# ─── Agent Mode ──────────────────────────────────────────────────
DRY_RUN=true                        # true = no real orders placed
AGENT_NAME=PAXIS Agent

# ─── MT5 Connection ──────────────────────────────────────────────
MT5_LOGIN=12345678                  # Your MT5 account number
MT5_PASSWORD=your_mt5_password
MT5_SERVER=JustMarkets-Dem2         # or JustMarkets-Live
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_REMOTE_IP=                      # Optional: Windows machine IP to connect via remote HTTP bridge (e.g. 192.168.1.50)
MT5_REMOTE_PORT=8000                # Port for remote HTTP bridge (default: 8000)

# ─── Trading Pairs ───────────────────────────────────────────────
TRADING_PAIRS=XAUUSD  # Comma-separated MT5 symbols

# ─── Ollama / LLM ────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=plutus                 # Your fine-tuned model name
OLLAMA_TEMPERATURE=0.3
OLLAMA_TOP_P=0.9
INFERENCE_TIMEOUT_SECONDS=45

# ─── Risk Parameters ─────────────────────────────────────────────
LOT_SIZE=0.01                       # Fixed lot size fallback
USE_DYNAMIC_RISK=true               # true = scale lot size dynamically, false = use static LOT_SIZE
RISK_PERCENT=1.0                    # Risk 1% of account balance per trade
AUTO_BREAKEVEN_RATIO=1.0            # Move SL to entry when trade hits 1:1 risk-to-reward ratio
TRAILING_STOP_ATR_MULTIPLIER=2.0    # Trailing stop distance = 2 * ATR (0.0 to disable)
ENFORCE_TREND_ALIGNMENT=true        # true = only trade in direction of H1/H4 EMA trend
DISABLE_RISK_GATE=false             # true = completely bypass and disable all risk gate checks
MIN_CONFIDENCE=0.70                 # Minimum LLM confidence to trade (0.0 - 1.0)
MAX_OPEN_TRADES=2                   # Max simultaneous open positions
MAX_SPREAD_PIPS=3.0                 # Max allowed spread in pips
MAX_DAILY_LOSS_USD=50.0             # Hard daily drawdown limit in USD
MIN_RR_RATIO=1.5                    # Minimum reward:risk ratio
NEWS_BLACKOUT_MINUTES=30            # Minutes before/after news to avoid trading

# ─── Scalping Parameters ──────────────────────────────────────────
SCALPING_MODE=true                  # Enable high-speed M1/M5/M15 scalping
SCALPING_TARGET_PROFIT_USD=1.0      # Target profit USD for 0.01 lot baseline
SCALPING_SL_USD=2.0                 # Stop Loss USD for 0.01 lot baseline


# ─── Scheduler ───────────────────────────────────────────────────
TRADE_CYCLE_MINUTES=3               # How often agent evaluates pairs
POSITION_POLL_SECONDS=20            # How often open positions are checked

# ─── Trading Sessions (UTC) ──────────────────────────────────────
LONDON_SESSION_START=07:00          # London open UTC
LONDON_SESSION_END=12:00            # London close UTC
NY_SESSION_START=13:00              # New York open UTC
NY_SESSION_END=17:00                # New York close UTC

# ─── Telegram Bot ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
TELEGRAM_SILENT_HOLDS=true          # Don't send Telegram msg on every HOLD

# ─── Dashboard ───────────────────────────────────────────────────
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
DASHBOARD_SECRET_KEY=change-this-secret-key-in-production

# ─── Database ────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./paxis_trades.db

# ─── Logging ─────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs
