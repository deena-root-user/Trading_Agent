# ═══════════════════════════════════════════════════════════════════
#  PAXIS TRADING AGENT — ENVIRONMENT CONFIGURATION TEMPLATE
# ═══════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.

# ─── Agent Mode ──────────────────────────────────────────────────
DRY_RUN=true
AGENT_NAME=PAXIS Agent

# ─── MT5 Connection ──────────────────────────────────────────────
MT5_LOGIN=YOUR_MT5_ACCOUNT_NUMBER
MT5_PASSWORD=YOUR_MT5_PASSWORD
MT5_SERVER=YOUR_BROKER_SERVER
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_REMOTE_IP=127.0.0.1
MT5_REMOTE_PORT=8001

# ─── Trading Pairs ───────────────────────────────────────────────
TRADING_PAIRS=XAUUSD

# ─── OmniRoute AI Gateway / LLM Routing ──────────────────────────
USE_LOCAL_OLLAMA=false
LLM_PROVIDER=api
LLM_API_KEY=YOUR_LLM_API_KEY
LLM_API_BASE_URL=http://your-api-endpoint:20128/v1
LLM_API_MODEL=kr/claude-sonnet-4.5
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_FALLBACK_MODEL=qwen2.5:3b
OLLAMA_TEMPERATURE=0.3
OLLAMA_TOP_P=0.9
INFERENCE_TIMEOUT_SECONDS=300

# ─── Smart Confluence & AI Token Routing ─────────────────────────
CONFLUENCE_LLM_THRESHOLD=0.55
CONFLUENCE_API_THRESHOLD=0.65
ENABLE_VISION=false
VISION_TIMEOUT_SECONDS=60

# ─── Strategy Mode (Pure Mechanical / 0 LLM Tokens) ──────────────
STRATEGY_MODE=true

# ─── Pro Trader Mode (4-Timeframe SMC Engine) ────────────────────
PRO_TRADER_MODE=true
PRO_TRADER_USE_TRADINGVIEW_SCRAPE=false
TRADINGVIEW_CHART_URL=https://www.tradingview.com/chart/YOUR_CHART_ID/
TRADINGVIEW_SESSION_ID=YOUR_TRADINGVIEW_SESSION_ID
PRO_TRADER_MIN_RR=2.0

# ─── Risk & Position Management ──────────────────────────────────
LOT_SIZE=0.01
USE_DYNAMIC_RISK=true
RISK_PERCENT=1.0
AUTO_BREAKEVEN_RATIO=1.0
TRAILING_STOP_ATR_MULTIPLIER=2.0
ENFORCE_TREND_ALIGNMENT=true
DISABLE_RISK_GATE=false
MIN_CONFIDENCE=0.65
MAX_OPEN_TRADES=2
MAX_SPREAD_PIPS=30.0
MAX_DAILY_LOSS_USD=50.0
MIN_RR_RATIO=2.0
NEWS_BLACKOUT_MINUTES=30

# ─── Telegram Bot Notifications ──────────────────────────────────
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID
TELEGRAM_SILENT_HOLDS=true

# ─── Dashboard ───────────────────────────────────────────────────
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
DASHBOARD_SECRET_KEY=GENERATE_A_RANDOM_SECRET_KEY_HERE

# ─── Database ────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./paxis_trades.db

# ─── Logging ─────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs
